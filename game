<!DOCTYPE html>
<html lang="id" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Game Aritmatika Cepat — Mental Math Drill</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    colors: {
                        slate: {
                            850: '#161b26',
                            925: '#0d1117',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        /* Hilangkan panah spinner pada input angka */
        input[type=number]::-webkit-inner-spin-button,
        input[type=number]::-webkit-outer-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }
        input[type=number] {
            -moz-appearance: textfield;
        }

        /* Animasi flash halus saat jawaban benar atau skip */
        @keyframes pulseGreen {
            0% { background-color: rgba(16, 185, 129, 0.22); }
            100% { background-color: transparent; }
        }
        @keyframes shakeRed {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-6px); }
            75% { transform: translateX(6px); }
        }
        .flash-correct {
            animation: pulseGreen 0.25s ease-out;
        }
        .shake-skip {
            animation: shakeRed 0.25s ease-in-out;
        }

        /* Transisi tema yang halus */
        body {
            transition: background-color 0.2s ease, color 0.2s ease;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 dark:bg-slate-925 dark:text-slate-100 min-h-screen flex flex-col justify-between selection:bg-amber-500 selection:text-slate-950">

    <!-- Header / Navbar -->
    <header class="w-full max-w-4xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between border-b border-slate-200 dark:border-slate-800/80">
        <div class="flex items-center gap-2.5 cursor-pointer" onclick="goHome()">
            <div class="w-9 h-9 rounded-xl bg-amber-500 text-slate-950 flex items-center justify-center font-mono font-bold text-lg shadow-sm">
                ∑x
            </div>
            <div>
                <h1 class="font-bold text-base sm:text-lg tracking-tight leading-none" data-i18n="appTitle">Aritmatika Cepat</h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5" data-i18n="appSubtitle">Mental Math & Algebra Drill</p>
            </div>
        </div>

        <div class="flex items-center gap-2">
            <!-- Toggle Bahasa (ID / EN) -->
            <button id="btn-lang" onclick="toggleLanguage()" class="px-2.5 py-1.5 rounded-lg text-xs font-mono font-semibold bg-slate-200/70 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 transition" title="Ganti Bahasa / Switch Language">
                ID
            </button>

            <!-- Toggle Suara (Web Audio API) -->
            <button id="btn-sound" onclick="toggleSound()" class="p-2 rounded-lg bg-slate-200/70 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 transition" title="Efek Suara">
                <!-- Ikon Sound Off (Default) -->
                <svg id="icon-sound-off" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2" />
                </svg>
                <!-- Ikon Sound On -->
                <svg id="icon-sound-on" class="w-4 h-4 hidden text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
                </svg>
            </button>

            <!-- Toggle Tema Dark/Light -->
            <button id="btn-theme" onclick="toggleTheme()" class="p-2 rounded-lg bg-slate-200/70 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 transition" title="Ganti Tema">
                <!-- Ikon Sun (muncul saat Dark Mode) -->
                <svg id="icon-sun" class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
                <!-- Ikon Moon (muncul saat Light Mode) -->
                <svg id="icon-moon" class="w-4 h-4 hidden text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
                </svg>
            </button>
        </div>
    </header>

    <!-- Main Container -->
    <main class="w-full max-w-4xl mx-auto px-4 sm:px-6 py-6 flex-grow flex flex-col justify-center">

        <!-- ========================================================= -->
        <!-- 1. SCREEN KONFIGURASI / START                             -->
        <!-- ========================================================= -->
        <section id="screen-setup" class="space-y-6">
            <!-- Banner High Score & Preset -->
            <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 sm:p-6 shadow-sm">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-slate-100 dark:border-slate-800">
                    <div>
                        <span class="text-xs font-semibold uppercase tracking-wider text-amber-500" data-i18n="presetLabel">Tingkat Kesulitan</span>
                        <div class="flex flex-wrap gap-2 mt-2" id="preset-buttons">
                            <button type="button" onclick="applyPreset('easy')" data-preset="easy" class="preset-btn px-3.5 py-1.5 rounded-xl text-sm font-medium border transition">Mudah</button>
                            <button type="button" onclick="applyPreset('standard')" data-preset="standard" class="preset-btn px-3.5 py-1.5 rounded-xl text-sm font-medium border transition">Standar (Zetamac)</button>
                            <button type="button" onclick="applyPreset('hard')" data-preset="hard" class="preset-btn px-3.5 py-1.5 rounded-xl text-sm font-medium border transition">Sulit</button>
                            <button type="button" onclick="applyPreset('custom')" data-preset="custom" class="preset-btn px-3.5 py-1.5 rounded-xl text-sm font-medium border transition">Kustom</button>
                        </div>
                    </div>

                    <div class="bg-slate-100 dark:bg-slate-850 px-4 py-3 rounded-xl border border-slate-200/70 dark:border-slate-800 flex items-center gap-3 self-start sm:self-center">
                        <div class="text-amber-500">
                            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                            </svg>
                        </div>
                        <div>
                            <div class="text-xs text-slate-500 dark:text-slate-400" data-i18n="highScoreLabel">Rekor Tertinggi (<span id="hs-duration-label">120d</span>)</div>
                            <div class="font-mono font-bold text-xl text-slate-900 dark:text-white" id="high-score-display">0</div>
                        </div>
                    </div>
                </div>

                <!-- Pilihan Durasi & Mode Submit -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-5">
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2.5" data-i18n="durationLabel">Durasi Latihan</label>
                        <div class="grid grid-cols-4 gap-2" id="duration-buttons">
                            <button type="button" onclick="selectDuration(30)" data-dur="30" class="dur-btn py-2 rounded-xl font-mono text-sm font-semibold border transition">30s</button>
                            <button type="button" onclick="selectDuration(60)" data-dur="60" class="dur-btn py-2 rounded-xl font-mono text-sm font-semibold border transition">60s</button>
                            <button type="button" onclick="selectDuration(120)" data-dur="120" class="dur-btn py-2 rounded-xl font-mono text-sm font-semibold border transition">120s</button>
                            <button type="button" onclick="selectDuration(300)" data-dur="300" class="dur-btn py-2 rounded-xl font-mono text-sm font-semibold border transition">300s</button>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2.5" data-i18n="inputModeLabel">Mode Pengiriman Jawaban</label>
                        <label class="flex items-center justify-between p-2.5 rounded-xl bg-slate-100/80 dark:bg-slate-850 border border-slate-200/80 dark:border-slate-800 cursor-pointer">
                            <div>
                                <span class="text-sm font-medium block" data-i18n="autoSubmitTitle">Auto-Submit Jawaban Benar</span>
                                <span class="text-xs text-slate-500 dark:text-slate-400" data-i18n="autoSubmitDesc">Langsung lanjut soal berikutnya tanpa tekan Enter</span>
                            </div>
                            <input type="checkbox" id="opt-autosubmit" checked class="w-5 h-5 accent-amber-500 rounded cursor-pointer">
                        </label>
                    </div>
                </div>
            </div>

            <!-- Pengaturan Operasi & Rentang Angka -->
            <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 sm:p-6 shadow-sm space-y-4">
                <div class="flex items-center justify-between">
                    <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400" data-i18n="operationsHeader">Pilih Operasi & Rentang Angka</h2>
                    <span id="op-warning" class="text-xs text-rose-500 font-medium hidden" data-i18n="selectOneOp">Pilih minimal 1 operasi!</span>
                </div>

                <div class="space-y-3">
                    <!-- Penjumlahan -->
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-3.5 rounded-xl bg-slate-50 dark:bg-slate-850/90 border border-slate-200/70 dark:border-slate-800">
                        <label class="flex items-center gap-3 cursor-pointer min-w-[170px]">
                            <input type="checkbox" id="op-add" checked onchange="onConfigChange()" class="w-4 h-4 accent-amber-500 rounded">
                            <span class="font-medium text-sm"><span class="font-mono text-amber-500 font-bold mr-1.5">+</span> <span data-i18n="opAdd">Penjumlahan</span></span>
                        </label>
                        <div class="flex flex-wrap items-center gap-2 text-xs font-mono text-slate-600 dark:text-slate-300">
                            <span>(</span>
                            <input type="number" id="add-min1" value="2" onchange="onConfigChange()" class="w-16 px-2 py-1 rounded-lg bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-center focus:border-amber-500 focus:outline-none">
                            <span data-i18n="to">s/d</span>
                            <input type="number" id="add-max1" value="100" onchange="onConfigChange()" class="w-16 px-2 py-1 rounded-lg bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-center focus:border-amber-500 focus:outline-none">
                            <span>) + (</span>
                            <input type="number" id="add-min2" value="2" onchange="onConfigChange()" class="w-16 px-2 py-1 rounded-lg bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-center focus:border-amber-500 focus:outline-none">
                            <span data-i18n="to">s/d</span>
                            <input type="number" id="add-max2" value="100" onchange="onConfigChange()" class="w-16 px-2 py-1 rounded-lg bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-center focus:border-amber-500 focus:outline-none">
                            <span>)</span>
                        </div>
                    </div>

                    <!-- Pengurangan -->
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-3.5 rounded-xl bg-slate-50 dark:bg-slate-850/90 border border-slate-200/70 dark:border-slate-800">
                        <label class="flex items-center gap-3 cursor-pointer min-w-[170px]">
                            <input type="checkbox" id="op-sub" checked onchange="onConfigChange()" class="w-4 h-4 accent-amber-500 rounded">
                            <span class="font-medium text-sm"><span class="font-mono text-amber-500 font-bold mr-1.5">−</span> <span data-i18n="opSub">Pengurangan</span></span>
                        </label>
                        <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
                            <span data-i18n="subNote">Kebalikan penjumlahan (hasil bulat positif)</span>
                            <label class="inline-flex items-center gap-1.5 ml-2 cursor-pointer text-slate-700 dark:text-slate-300">
                                <input type="checkbox" id="sub-negative" onchange="onConfigChange()" class="w-3.5 h-3.5 accent-amber-500 rounded">
                                <span data-i18n="allowNeg">Izinkan negatif</span>
                            </label>
                        </div>
                    </div>

                    <!-- Perkalian -->
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-3.5 rounded-xl bg-slate-50 dark:bg-slate-850/90 border border-slate-200/70 dark:border-slate-800">
                        <label class="flex items-center gap-3 cursor-pointer min-w-[170px]">
                            <input type="checkbox" id="op-mul" checked onchange="onConfigChange()" class="w-4 h-4 accent-amber-500 rounded">
                            <span class="font-medium text-sm"><span class="font-mono text-amber-500 font-bold mr-1.5">×</span> <span data-i18n="opMul">Perkalian</span></span>
                        </label>
                        <div class="flex flex-wrap items-center gap-2 text-xs font-mono text-slate-600 dark:text-slate-300">
                            <span>(</span>
                            <input type="number" id="mul-min1" value="2" onchange="onConfigChange()" class="w-16 px-2 py-1 rounded-lg bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-center focus:border-amber-500 focus:outline-none">
                            <span data-i18n="to">s/d</span>
                            <input type="number" id="mul-max1" value="12" onchange="onConfigChange()" class="w-16 px-2 py-1 rounded-lg bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-center focus:border-amber-500 focus:outline-none">
                            <span>) × (</span>
                            <input type="number" id="mul-min2" value="2" onchange="onConfigChange()" class="w-16 px-2 py-1 rounded-lg bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-center focus:border-amber-500 focus:outline-none">
                            <span data-i18n="to">s/d</span>
                            <input type="number" id="mul-max2" value="100" onchange="onConfigChange()" class="w-16 px-2 py-1 rounded-lg bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-center focus:border-amber-500 focus:outline-none">
                            <span>)</span>
                        </div>
                    </div>

                    <!-- Pembagian -->
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-3.5 rounded-xl bg-slate-50 dark:bg-slate-850/90 border border-slate-200/70 dark:border-slate-800">
                        <label class="flex items-center gap-3 cursor-pointer min-w-[170px]">
                            <input type="checkbox" id="op-div" checked onchange="onConfigChange()" class="w-4 h-4 accent-amber-500 rounded">
                            <span class="font-medium text-sm"><span class="font-mono text-amber-500 font-bold mr-1.5">÷</span> <span data-i18n="opDiv">Pembagian</span></span>
                        </label>
                        <div class="text-xs text-slate-500 dark:text-slate-400" data-i18n="divNote">
                            Kebalikan perkalian di atas (hasil selalu bilangan bulat tanpa sisa)
                        </div>
                    </div>

                    <!-- Aljabar Dasar -->
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-3.5 rounded-xl bg-slate-50 dark:bg-slate-850/90 border border-slate-200/70 dark:border-slate-800">
                        <label class="flex items-center gap-3 cursor-pointer min-w-[170px]">
                            <input type="checkbox" id="op-alg" onchange="onConfigChange()" class="w-4 h-4 accent-amber-500 rounded">
                            <span class="font-medium text-sm"><span class="font-mono text-amber-500 font-bold mr-1.5">x</span> <span data-i18n="opAlg">Aljabar Dasar</span></span>
                        </label>
                        <div class="flex flex-wrap items-center gap-2 text-xs font-mono text-slate-600 dark:text-slate-300">
                            <span>ax + b = c &nbsp;|&nbsp; x ∈ [</span>
                            <input type="number" id="alg-xmin" value="1" onchange="onConfigChange()" class="w-14 px-2 py-1 rounded-lg bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-center focus:border-amber-500 focus:outline-none">
                            <span data-i18n="to">s/d</span>
                            <input type="number" id="alg-xmax" value="15" onchange="onConfigChange()" class="w-14 px-2 py-1 rounded-lg bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-center focus:border-amber-500 focus:outline-none">
                            <span>]</span>
                        </div>
                    </div>
                </div>

                <!-- Tombol Mulai -->
                <div class="pt-3">
                    <button id="btn-start" onclick="startGame()" class="w-full py-3.5 px-6 rounded-xl bg-amber-500 hover:bg-amber-400 active:scale-[0.99] text-slate-950 font-bold text-base sm:text-lg shadow-lg shadow-amber-500/20 transition flex items-center justify-center gap-2">
                        <span data-i18n="startBtn">Mulai Latihan</span>
                        <span class="text-xs font-mono bg-slate-950/15 px-2 py-0.5 rounded">Enter</span>
                    </button>
                </div>
            </div>
        </section>

        <!-- ========================================================= -->
        <!-- 2. SCREEN ACTIVE GAMEPLAY                                 -->
        <!-- ========================================================= -->
        <section id="screen-play" class="hidden flex-col justify-between space-y-6">
            <!-- Top Bar: Timer, Score, Streak -->
            <div class="grid grid-cols-3 gap-3 sm:gap-4">
                <div id="timer-box" class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-3.5 sm:p-4 text-center transition-colors">
                    <div class="text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider" data-i18n="timeLabel">Sisa Waktu</div>
                    <div id="display-timer" class="font-mono font-bold text-2xl sm:text-3xl text-slate-900 dark:text-white mt-0.5">120</div>
                </div>

                <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-3.5 sm:p-4 text-center">
                    <div class="text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider" data-i18n="scoreLabel">Skor</div>
                    <div id="display-score" class="font-mono font-bold text-2xl sm:text-3xl text-amber-500 mt-0.5">0</div>
                </div>

                <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-3.5 sm:p-4 text-center">
                    <div class="text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider" data-i18n="streakLabel">Streak</div>
                    <div id="display-streak" class="font-mono font-bold text-2xl sm:text-3xl text-emerald-500 mt-0.5">0</div>
                </div>
            </div>

            <!-- Area Soal Utama -->
            <div id="problem-card" class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-8 sm:p-14 shadow-sm flex flex-col items-center justify-center min-h-[280px] sm:min-h-[320px] relative transition">
                <!-- Badge Jenis Operasi -->
                <span id="problem-badge" class="absolute top-4 left-4 text-xs font-mono px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400">
                    +
                </span>

                <!-- Tombol Akhiri Cepat -->
                <button onclick="endGame()" class="absolute top-4 right-4 text-xs text-slate-400 hover:text-rose-500 transition px-2 py-1 rounded-lg" data-i18n="quitBtn">
                    Akhiri
                </button>

                <!-- Teks Soal -->
                <div id="problem-text" class="font-mono font-bold text-4xl sm:text-6xl tracking-tight text-slate-900 dark:text-white text-center mb-8 select-none">
                    12 + 15
                </div>

                <!-- Input Jawaban -->
                <div class="w-full max-w-xs relative">
                    <input
                        type="text"
                        inputmode="numeric"
                        pattern="[0-9\-]*"
                        id="answer-input"
                        autocomplete="off"
                        autocorrect="off"
                        spellcheck="false"
                        placeholder="?"
                        class="w-full text-center font-mono font-bold text-3xl sm:text-4xl py-3 px-4 rounded-2xl bg-slate-100 dark:bg-slate-850 border-2 border-slate-300 dark:border-slate-700 focus:border-amber-500 dark:focus:border-amber-500 focus:outline-none text-slate-900 dark:text-white transition"
                    />
                </div>

                <!-- Kontrol Bawah (Skip & Petunjuk) -->
                <div class="mt-6 flex items-center gap-4 text-xs text-slate-500 dark:text-slate-400">
                    <button type="button" onclick="skipProblem()" class="px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 font-medium transition flex items-center gap-1.5">
                        <span data-i18n="skipBtn">Lewati Soal (-2d)</span>
                        <kbd class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700">Esc</kbd>
                    </button>
                    <span id="enter-hint" class="hidden font-mono" data-i18n="pressEnterHint">Tekan Enter untuk kirim</span>
                </div>
            </div>
        </section>

        <!-- ========================================================= -->
        <!-- 3. SCREEN GAME OVER / RINGKASAN HASIL                     -->

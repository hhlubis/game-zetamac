        /* =====================================================================
           2. WEB AUDIO API (EFEK SUARA SINTETIS TANPA FILE EKSTERNAL)
           ===================================================================== */
        let audioCtx = null;

        function playTone(type) {
            if (!state.soundEnabled) return;
            try {
                if (!audioCtx) {
                    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                }
                if (audioCtx.state === 'suspended') {
                    audioCtx.resume();
                }

                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.connect(gain);
                gain.connect(audioCtx.destination);

                const now = audioCtx.currentTime;
                if (type === 'correct') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(587.33, now); // D5
                    osc.frequency.exponentialRampToValueAtTime(880, now + 0.08); // A5
                    gain.gain.setValueAtTime(0.08, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.12);
                    osc.start(now);
                    osc.stop(now + 0.12);
                } else if (type === 'skip') {
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(220, now);
                    osc.frequency.linearRampToValueAtTime(160, now + 0.15);
                    gain.gain.setValueAtTime(0.08, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.15);
                    osc.start(now);
                    osc.stop(now + 0.15);
                } else if (type === 'end') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(523.25, now); // C5
                    osc.frequency.setValueAtTime(659.25, now + 0.12); // E5
                    osc.frequency.setValueAtTime(783.99, now + 0.24); // G5
                    gain.gain.setValueAtTime(0.1, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.5);
                    osc.start(now);
                    osc.stop(now + 0.5);
                }
            } catch (e) {
                // Abaikan jika browser memblokir audio
            }
        }

        /* =====================================================================
           3. PENGATURAN UI, TEMA, BAHASA, DAN PRESET
           ===================================================================== */
        function toggleTheme() {
            const html = document.documentElement;
            const isDark = html.classList.toggle('dark');
            document.getElementById('icon-sun').classList.toggle('hidden', !isDark);
            document.getElementById('icon-moon').classList.toggle('hidden', isDark);
        }

        function toggleSound() {
            state.soundEnabled = !state.soundEnabled;
            document.getElementById('icon-sound-on').classList.toggle('hidden', !state.soundEnabled);
            document.getElementById('icon-sound-off').classList.toggle('hidden', state.soundEnabled);
            if (state.soundEnabled) playTone('correct');
        }

        function toggleLanguage() {
            state.lang = state.lang === 'id' ? 'en' : 'id';
            document.getElementById('btn-lang').textContent = state.lang.toUpperCase();
            applyTranslations();
            updateHighScoreUI();
        }

        function applyTranslations() {
            const dict = i18n[state.lang];
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (dict[key]) el.textContent = dict[key];
            });
            // Update label preset
            const presetNames = state.lang === 'id'
                ? { easy: 'Mudah', standard: 'Standar (Zetamac)', hard: 'Sulit', custom: 'Kustom' }
                : { easy: 'Easy', standard: 'Standard (Zetamac)', hard: 'Hard', custom: 'Custom' };
            document.querySelectorAll('.preset-btn').forEach(btn => {
                const p = btn.getAttribute('data-preset');
                btn.textContent = presetNames[p];
            });
        }

        function selectDuration(sec) {
            state.duration = sec;
            document.querySelectorAll('.dur-btn').forEach(btn => {
                const isSelected = Number(btn.getAttribute('data-dur')) === sec;
                btn.className = isSelected
                    ? 'dur-btn py-2 rounded-xl font-mono text-sm font-bold border border-amber-500 bg-amber-500/15 text-amber-600 dark:text-amber-400 transition'
                    : 'dur-btn py-2 rounded-xl font-mono text-sm font-semibold border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-850 text-slate-600 dark:text-slate-400 hover:border-slate-300 dark:hover:border-slate-700 transition';
            });
            updateHighScoreUI();
        }

        function applyPreset(preset) {
            state.preset = preset;
            document.querySelectorAll('.preset-btn').forEach(btn => {
                const isSelected = btn.getAttribute('data-preset') === preset;
                btn.className = isSelected
                    ? 'preset-btn px-3.5 py-1.5 rounded-xl text-sm font-semibold border border-amber-500 bg-amber-500/15 text-amber-600 dark:text-amber-400 transition'
                    : 'preset-btn px-3.5 py-1.5 rounded-xl text-sm font-medium border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-850 text-slate-600 dark:text-slate-400 hover:border-slate-300 dark:hover:border-slate-700 transition';
            });

            if (preset === 'easy') {
                setRanges(1, 20, 1, 20, 2, 10, 2, 10, 1, 10);
                document.getElementById('op-add').checked = true;
                document.getElementById('op-sub').checked = true;
                document.getElementById('op-mul').checked = true;
                document.getElementById('op-div').checked = false;
                document.getElementById('op-alg').checked = false;
                document.getElementById('sub-negative').checked = false;
            } else if (preset === 'standard') {
                setRanges(2, 100, 2, 100, 2, 12, 2, 100, 1, 15);
                document.getElementById('op-add').checked = true;
                document.getElementById('op-sub').checked = true;
                document.getElementById('op-mul').checked = true;
                document.getElementById('op-div').checked = true;
                document.getElementById('op-alg').checked = false;
                document.getElementById('sub-negative').checked = false;
            } else if (preset === 'hard') {
                setRanges(15, 250, 15, 250, 3, 20, 3, 150, -10, 25);
                document.getElementById('op-add').checked = true;
                document.getElementById('op-sub').checked = true;
                document.getElementById('op-mul').checked = true;
                document.getElementById('op-div').checked = true;
                document.getElementById('op-alg').checked = true;
                document.getElementById('sub-negative').checked = true;
            }
            validateOperations();
        }

        function setRanges(aMin1, aMax1, aMin2, aMax2, mMin1, mMax1, mMin2, mMax2, xMin, xMax) {
            document.getElementById('add-min1').value = aMin1;
            document.getElementById('add-max1').value = aMax1;
            document.getElementById('add-min2').value = aMin2;
            document.getElementById('add-max2').value = aMax2;
            document.getElementById('mul-min1').value = mMin1;
            document.getElementById('mul-max1').value = mMax1;
            document.getElementById('mul-min2').value = mMin2;
            document.getElementById('mul-max2').value = mMax2;
            document.getElementById('alg-xmin').value = xMin;
            document.getElementById('alg-xmax').value = xMax;
        }

        function onConfigChange() {
            if (state.preset !== 'custom') {
                applyPreset('custom');
            }
            validateOperations();
        }

        function validateOperations() {
            const ops = getSelectedOperations();
            const warning = document.getElementById('op-warning');
            const startBtn = document.getElementById('btn-start');
            if (ops.length === 0) {
                warning.classList.remove('hidden');
                startBtn.disabled = true;
                startBtn.classList.add('opacity-50', 'cursor-not-allowed');
            } else {
                warning.classList.add('hidden');
                startBtn.disabled = false;
                startBtn.classList.remove('opacity-50', 'cursor-not-allowed');
            }
        }

        function getSelectedOperations() {
            const ops = [];
            if (document.getElementById('op-add').checked) ops.push('add');
            if (document.getElementById('op-sub').checked) ops.push('sub');
            if (document.getElementById('op-mul').checked) ops.push('mul');
            if (document.getElementById('op-div').checked) ops.push('div');
            if (document.getElementById('op-alg').checked) ops.push('alg');
            return ops;
        }

        function updateHighScoreUI() {
            const key = `dur_${state.duration}`;
            const best = state.highScores[key] || 0;
            const suffix = state.lang === 'id' ? 'd' : 's';
            const hsLabel = document.getElementById('hs-duration-label');
            if (hsLabel) hsLabel.textContent = `${state.duration}${suffix}`;
            document.getElementById('high-score-display').textContent = best;
        }

        /* =====================================================================
           4. GENERATOR SOAL MATEMATIKA & ALJABAR
           ===================================================================== */
        function randInt(min, max) {
            min = Math.ceil(Math.min(min, max));
            max = Math.floor(Math.max(min, max));
            return Math.floor(Math.random() * (max - min + 1)) + min;
        }

        function generateProblem() {
            const ops = getSelectedOperations();
            const op = ops[Math.floor(Math.random() * ops.length)];

            const aMin1 = parseInt(document.getElementById('add-min1').value) || 2;
            const aMax1 = parseInt(document.getElementById('add-max1').value) || 100;
            const aMin2 = parseInt(document.getElementById('add-min2').value) || 2;
            const aMax2 = parseInt(document.getElementById('add-max2').value) || 100;

            const mMin1 = parseInt(document.getElementById('mul-min1').value) || 2;
            const mMax1 = parseInt(document.getElementById('mul-max1').value) || 12;
            const mMin2 = parseInt(document.getElementById('mul-min2').value) || 2;
            const mMax2 = parseInt(document.getElementById('mul-max2').value) || 100;

            let text = '';
            let answer = 0;
            let badge = '';

            if (op === 'add') {
                const a = randInt(aMin1, aMax1);
                const b = randInt(aMin2, aMax2);
                text = `${a} + ${b}`;
                answer = a + b;
                badge = '+';
            } else if (op === 'sub') {
                const allowNeg = document.getElementById('sub-negative').checked;
                const a = randInt(aMin1, aMax1);
                const b = randInt(aMin2, aMax2);
                if (allowNeg) {
                    text = `${a} − ${b}`;
                    answer = a - b;
                } else {
                    const sum = a + b;
                    text = `${sum} − ${a}`;
                    answer = b;
                }
                badge = '−';
            } else if (op === 'mul') {
                const a = randInt(mMin1, mMax1);
                const b = randInt(mMin2, mMax2);
                text = `${a} × ${b}`;
                answer = a * b;
                badge = '×';
            } else if (op === 'div') {
                let a = randInt(mMin1, mMax1);
                if (a === 0) a = 2; // Hindari pembagian dengan nol
                const b = randInt(mMin2, mMax2);
                const product = a * b;
                text = `${product} ÷ ${a}`;
                answer = b;
                badge = '÷';
            } else if (op === 'alg') {
                // Persamaan linear: ax + b = c atau ax - b = c
                const xMin = parseInt(document.getElementById('alg-xmin').value) || 1;
                const xMax = parseInt(document.getElementById('alg-xmax').value) || 15;
                let x = randInt(xMin, xMax);
                let a = randInt(2, 9);
                const b = randInt(1, 25);
                const isPlus = Math.random() > 0.4;

                if (isPlus) {
                    const c = a * x + b;
                    text = `${a}x + ${b} = ${c}`;
                } else {
                    const c = a * x - b;
                    text = `${a}x − ${b} = ${c}`;
                }
                answer = x;
                badge = 'x = ?';
            }

            // Hindari soal yang sama persis dua kali berturut-turut
            if (state.currentProblem && state.currentProblem.text === text) {
                return generateProblem();
            }

            state.currentProblem = { op, text, answer, badge };
            state.problemStartTime = performance.now();

            document.getElementById('problem-badge').textContent = badge;
            document.getElementById('problem-text').textContent = text;
        }

        /* =====================================================================
           5. ALUR PERMAINAN (START, INPUT CHECK, SKIP, GAME OVER)
           ===================================================================== */
        function switchScreen(screenName) {
            state.screen = screenName;
            document.getElementById('screen-setup').classList.toggle('hidden', screenName !== 'setup');
            document.getElementById('screen-play').classList.toggle('hidden', screenName !== 'play');
            document.getElementById('screen-result').classList.toggle('hidden', screenName !== 'result');

            if (screenName === 'play') {
                document.getElementById('screen-play').classList.add('flex');
            } else {
                document.getElementById('screen-play').classList.remove('flex');
            }
        }

        function goHome() {
            if (state.timerInterval) clearInterval(state.timerInterval);
            showSetup();
        }

        function showSetup() {
            updateHighScoreUI();
            switchScreen('setup');
        }

        function startGame() {
            if (getSelectedOperations().length === 0) return;

            state.timeLeft = state.duration;
            state.score = 0;
            state.streak = 0;
            state.maxStreak = 0;
            state.history = [];

            updateGameplayHUD();
            switchScreen('play');

            const isAutoSubmit = document.getElementById('opt-autosubmit').checked;
            document.getElementById('enter-hint').classList.toggle('hidden', isAutoSubmit);

            generateProblem();

            const inputEl = document.getElementById('answer-input');
            inputEl.value = '';
            setTimeout(() => inputEl.focus(), 50);

            if (state.timerInterval) clearInterval(state.timerInterval);
            state.timerInterval = setInterval(() => {
                state.timeLeft--;
                updateGameplayHUD();
                if (state.timeLeft <= 0) {
                    endGame();
                }
            }, 1000);
        }

        function updateGameplayHUD() {
            const timerEl = document.getElementById('display-timer');
            const timerBox = document.getElementById('timer-box');
            timerEl.textContent = Math.max(0, state.timeLeft);

            // Efek urgensi visual saat waktu < 10 detik
            if (state.timeLeft <= 10 && state.timeLeft > 0) {
                timerEl.classList.add('text-rose-500');
                timerBox.classList.add('border-rose-500/50', 'bg-rose-500/5');
            } else {
                timerEl.classList.remove('text-rose-500');
                timerBox.classList.remove('border-rose-500/50', 'bg-rose-500/5');
            }

            document.getElementById('display-score').textContent = state.score;
            document.getElementById('display-streak').textContent = state.streak;
        }

        function handleCorrectAnswer() {
            const timeTaken = (performance.now() - state.problemStartTime) / 1000;
            state.history.push({
                op: state.currentProblem.op,
                text: state.currentProblem.text,
                answer: state.currentProblem.answer,
                timeTaken: timeTaken,
                skipped: false
            });

            state.score++;
            state.streak++;
            if (state.streak > state.maxStreak) state.maxStreak = state.streak;

            playTone('correct');
            updateGameplayHUD();

            // Flash feedback hijau singkat
            const card = document.getElementById('problem-card');
            card.classList.remove('flash-correct');
            void card.offsetWidth; // trigger reflow
            card.classList.add('flash-correct');

            const inputEl = document.getElementById('answer-input');
            inputEl.value = '';
            generateProblem();
        }

        function skipProblem() {
            if (state.screen !== 'play') return;

            const timeTaken = (performance.now() - state.problemStartTime) / 1000;
            state.history.push({
                op: state.currentProblem.op,
                text: state.currentProblem.text,
                answer: state.currentProblem.answer,
                timeTaken: timeTaken,
                skipped: true
            });

            // Penalti streak & pengurangan waktu 2 detik
            state.streak = 0;
            state.timeLeft = Math.max(0, state.timeLeft - 2);
            playTone('skip');
            updateGameplayHUD();

            const card = document.getElementById('problem-card');
            card.classList.remove('shake-skip');
            void card.offsetWidth;
            card.classList.add('shake-skip');

            if (state.timeLeft <= 0) {
                endGame();
                return;
            }

            const inputEl = document.getElementById('answer-input');
            inputEl.value = '';
            inputEl.focus();
            generateProblem();
        }

        function endGame() {
            if (state.timerInterval) {
                clearInterval(state.timerInterval);
                state.timerInterval = null;
            }
            playTone('end');

            // Cek & Simpan High Score
            const hsKey = `dur_${state.duration}`;
            const prevBest = state.highScores[hsKey] || 0;
            const isNewRecord = state.score > prevBest && state.score > 0;
            if (isNewRecord) {
                state.highScores[hsKey] = state.score;
                localStorage.setItem('aritmatika_highscores', JSON.stringify(state.highScores));
            }

            renderResults(isNewRecord);
            switchScreen('result');
        }

        /* =====================================================================
           6. RENDER HASIL & ANALITIK PERFORMA
           ===================================================================== */
        function renderResults(isNewRecord) {
            document.getElementById('new-record-badge').classList.toggle('hidden', !isNewRecord);

            const solved = state.history.filter(h => !h.skipped);
            const totalAttempted = state.history.length;
            const accuracy = totalAttempted > 0 ? Math.round((solved.length / totalAttempted) * 100) : 100;

            const totalSolvedTime = solved.reduce((acc, item) => acc + item.timeTaken, 0);
            const avgTime = solved.length > 0 ? (totalSolvedTime / solved.length) : 0;

            // QPM berdasarkan durasi sesi
            const minutes = state.duration / 60;
            const qpm = (state.score / minutes).toFixed(1);

            document.getElementById('res-score').textContent = state.score;
            document.getElementById('res-qpm').textContent = qpm;
            document.getElementById('res-avg-time').textContent = `${avgTime.toFixed(2)}s`;
            document.getElementById('res-accuracy').textContent = `${accuracy}%`;
            document.getElementById('res-attempted').textContent = `${solved.length}/${totalAttempted}`;

            // 1. Breakdown per Operasi
            const opMeta = {
                add: { symbol: '+', label: state.lang === 'id' ? 'Penjumlahan' : 'Addition' },
                sub: { symbol: '−', label: state.lang === 'id' ? 'Pengurangan' : 'Subtraction' },
                mul: { symbol: '×', label: state.lang === 'id' ? 'Perkalian' : 'Multiplication' },
                div: { symbol: '÷', label: state.lang === 'id' ? 'Pembagian' : 'Division' },
                alg: { symbol: 'x', label: state.lang === 'id' ? 'Aljabar' : 'Algebra' }
            };

            const breakdownEl = document.getElementById('breakdown-list');
            breakdownEl.innerHTML = '';

            const usedOps = Object.keys(opMeta).filter(op => state.history.some(h => h.op === op));
            if (usedOps.length === 0) {
                breakdownEl.innerHTML = `<p class="text-xs text-slate-400">${i18n[state.lang].noData}</p>`;
            } else {
                usedOps.forEach(op => {
                    const items = solved.filter(h => h.op === op);
                    const avg = items.length > 0
                        ? (items.reduce((s, i) => s + i.timeTaken, 0) / items.length).toFixed(2) + 's'
                        : '-';
                    breakdownEl.innerHTML += `
                        <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 dark:bg-slate-850 border border-slate-200/60 dark:border-slate-800 text-sm">
                            <div class="flex items-center gap-2.5">
                                <span class="w-7 h-7 rounded-lg bg-amber-500/15 text-amber-500 font-mono font-bold flex items-center justify-center text-xs">${opMeta[op].symbol}</span>
                                <span class="font-medium">${opMeta[op].label}</span>
                            </div>
                            <div class="font-mono text-xs flex items-center gap-4">
                                <span class="text-slate-500 dark:text-slate-400">${items.length} soal</span>
                                <span class="font-bold text-slate-900 dark:text-white w-14 text-right">${avg}</span>
                            </div>
                        </div>
                    `;
                });
            }

            // 2. Soal Terlambat atau Dilewati (Review)
            const reviewEl = document.getElementById('review-list');
            reviewEl.innerHTML = '';

            // Urutkan berdasarkan yang dilewati dulu, lalu waktu terlama
            const sortedReview = [...state.history]
                .sort((a, b) => (b.skipped - a.skipped) || (b.timeTaken - a.timeTaken))
                .slice(0, 6);

            if (sortedReview.length === 0) {
                reviewEl.innerHTML = `<p class="text-xs text-slate-400">${i18n[state.lang].noData}</p>`;
            } else {
                sortedReview.forEach(item => {
                    const statusBadge = item.skipped
                        ? `<span class="text-[11px] font-medium px-2 py-0.5 rounded bg-rose-500/15 text-rose-500">${i18n[state.lang].skippedTag}</span>`
                        : `<span class="font-mono text-xs text-slate-500 dark:text-slate-400">${item.timeTaken.toFixed(2)}s</span>`;

                    reviewEl.innerHTML += `
                        <div class="flex items-center justify-between p-2.5 px-3 rounded-xl bg-slate-50 dark:bg-slate-850 border border-slate-200/60 dark:border-slate-800 text-sm">
                            <div class="font-mono">
                                <span class="text-slate-700 dark:text-slate-200">${item.text}</span>
                                <span class="text-amber-500 font-bold ml-1.5">= ${item.answer}</span>
                            </div>
                            ${statusBadge}
                        </div>
                    `;
                });
            }
        }

        /* =====================================================================
           7. EVENT LISTENERS KEYBOARD & INPUT
           ===================================================================== */
        const answerInput = document.getElementById('answer-input');

        answerInput.addEventListener('input', (e) => {
            if (state.screen !== 'play' || !state.currentProblem) return;

            // Bersihkan karakter selain angka dan tanda minus di awal
            let raw = e.target.value.replace(/[^0-9\-]/g, '');
            if (raw.indexOf('-') > 0) {
                raw = raw.replace(/-/g, '');
            }
            e.target.value = raw;

            const isAutoSubmit = document.getElementById('opt-autosubmit').checked;
            if (isAutoSubmit && raw !== '' && raw !== '-') {
                const numericVal = parseInt(raw, 10);
                if (numericVal === state.currentProblem.answer) {
                    handleCorrectAnswer();
                }
            }
        });

        answerInput.addEventListener('keydown', (e) => {
            if (state.screen !== 'play') return;

            if (e.key === 'Enter') {
                e.preventDefault();
                const val = parseInt(answerInput.value, 10);
                if (!isNaN(val) && val === state.currentProblem.answer) {
                    handleCorrectAnswer();
                } else {
                    // Beri efek getar ringan jika salah tekan Enter
                    answerInput.classList.add('border-rose-500');
                    setTimeout(() => answerInput.classList.remove('border-rose-500'), 200);
                }
            } else if (e.key === 'Escape') {
                e.preventDefault();
                skipProblem();
            }
        });

        // Shortcut Keyboard Global (Enter untuk mulai / main lagi)
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                if (state.screen === 'setup' && document.activeElement.tagName !== 'INPUT') {
                    e.preventDefault();
                    startGame();
                } else if (state.screen === 'result') {
                    e.preventDefault();
                    startGame();
                }
            }
        });

        // Inisialisasi awal saat halaman dimuat
        window.onload = function () {
            selectDuration(120);
            applyPreset('standard');
            applyTranslations();
            updateHighScoreUI();
        };
    </script>
</body>
</html>
